# MongoDB connection string
MONGO_URI=your-mongo-uri

# Port for the server
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# OpenAI API key (for roadmap generation and interview grading)
OPENAI_API_KEY=sk-your-openai-api-key

# JWT secret (any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-random-jwt-secret

# Adzuna job search API credentials (https://developer.adzuna.com)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key